---
import '../styles/global.css';
import { site, siteOrigin, topics } from '../config';
import { graph, type JsonLd } from '../lib/seo';
import { ogImageForSite } from '../lib/essays';
import { publicPath } from '../lib/urls';

interface Props {
  title?: string;
  description?: string;
  /** 社群分享圖的絕對網址，預設用站台通用圖。 */
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  jsonLd?: JsonLd[];
}

const {
  title,
  description = site.description,
  image = ogImageForSite(),
  type = 'website',
  publishedTime,
  modifiedTime,
  jsonLd = [],
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const path = Astro.url.pathname;

function current(href: string) {
  return path === href || (href !== publicPath('/') && path.startsWith(href));
}
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={publicPath('/rss.xml')} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ?? `${site.name} — ${site.tagline}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? site.tagline} />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    {type === 'article' && <meta property="article:author" content={site.author} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? `${site.name} — ${site.tagline}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" type="image/svg+xml" href={publicPath('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    {jsonLd.length > 0 && (
      <script type="application/ld+json" is:inline set:html={graph(jsonLd)} />
    )}
  </head>
  <body>
    <a class="skip-link" href="#content">跳到內容</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={publicPath('/')}>
          <span class="logo-mark" aria-hidden="true">知</span>
          <span class="brand-text">
            <span class="brand-name">{site.name}</span>
            <span class="brand-tag">{site.tagline}</span>
          </span>
        </a>
        <nav class="nav" aria-label="主要">
          {topics.map((topic) => (
            <a href={publicPath(`/topics/${topic.slug}/`)} aria-current={current(publicPath(`/topics/${topic.slug}/`)) ? 'page' : undefined}>
              {topic.name}
            </a>
          ))}
          <a href={publicPath('/essays/')} aria-current={current(publicPath('/essays/')) && !path.startsWith(publicPath('/topics/')) ? 'page' : undefined}>
            全部文章
          </a>
          <a href={publicPath('/about/')} aria-current={current(publicPath('/about/')) ? 'page' : undefined}>關於</a>
        </nav>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <p class="footer-brand">{site.name}</p>
          <p class="footer-copy">{site.tagline}</p>
        </div>
        <nav class="footer-nav" aria-label="頁尾">
          {topics.map((topic) => (
            <a href={publicPath(`/topics/${topic.slug}/`)}>{topic.name}</a>
          ))}
          <a href={publicPath('/topics/')}>主題總覽</a>
          <a href={publicPath('/essays/')}>全部文章</a>
          <a href={publicPath('/about/')}>關於</a>
          <a href={publicPath('/rss.xml')}>RSS</a>
          <a href={`mailto:${site.email}`}>聯絡</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
